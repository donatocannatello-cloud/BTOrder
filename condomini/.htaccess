# Gestione Condomini - configurazione Apache (Aruba)

DirectoryIndex index.php
Options -Indexes

# Per forzare HTTPS (consigliato, dopo aver attivato il certificato SSL su Aruba)
# togli il commento alle tre righe seguenti:
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Blocca file nascosti (.htaccess, .git...), JSON, Markdown e file di lock/backup ovunque
<FilesMatch "(^\.|\.(json|md|lock|log|bak|zip)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>
