<Window x:Class="MultiAIDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi AI Desktop" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="BackButton" Content="◀" Width="32" Click="BackButton_Click" ToolTip="Indietro"/>
            <Button x:Name="ForwardButton" Content="▶" Width="32" Click="ForwardButton_Click" ToolTip="Avanti"/>
            <Button x:Name="ReloadButton" Content="⟳" Width="32" Click="ReloadButton_Click" ToolTip="Ricarica"/>
            <Separator/>
            <Button x:Name="ZoomOutButton" Content="-" Width="32" Click="ZoomOutButton_Click" ToolTip="Zoom -"/>
            <Button x:Name="ZoomInButton" Content="+" Width="32" Click="ZoomInButton_Click" ToolTip="Zoom +"/>
            <Separator/>
            <TextBlock VerticalAlignment="Center" Margin="8,0" FontStyle="Italic" Foreground="Gray"
                       Text="Ctrl+1 / Ctrl+2 / Ctrl+3 per cambiare tab"/>
        </ToolBar>
        <TabControl x:Name="ServiceTabs"/>
    </DockPanel>
</Window>
