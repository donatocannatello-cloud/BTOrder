<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necessario per leggere nome/indirizzo dei dispositivi Bluetooth accoppiati (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Necessario per rilevare lo stato della chiamata (OFFHOOK/IDLE) tramite TelephonyCallback -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Necessario per chiamare AudioManager.setCommunicationDevice -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Necessari per eseguire i Service in foreground (instradamento chiamate e
         automazioni di prossimità) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Necessario per mostrare le notifiche persistenti dei Service (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Per riavviare automaticamente il monitoraggio dopo l'accensione del telefono -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Per mantenere lo schermo acceso mentre il dispositivo di fiducia è connesso -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Permesso speciale (concesso dall'utente in Impostazioni) per estendere/ripristinare
         il timeout dello schermo -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- L'app funziona anche su dispositivi privi di Bluetooth (nessun dispositivo in lista) -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Visibilità dei pacchetti (Android 11+): serve per mostrare l'elenco delle app
         avviabili tra cui scegliere l'app da aprire alla connessione -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nome_app"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BTOrder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BTOrder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ProximityAutomationService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".CallRoutingService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
